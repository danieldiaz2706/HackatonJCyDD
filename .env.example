# Copien este archivo a .env (cp .env.example .env). .env no se versiona.

# Base de datos del cierre
POSTGRES_DB=cierre
POSTGRES_USER=cierre
POSTGRES_PASSWORD=cambiar-esta-clave

# Conexión usada por cierre-api y cierre-worker.
# DATABASE_HOST es el NOMBRE DEL SERVICIO en docker-compose.yml (cierre-db), no localhost.
DATABASE_HOST=cierre-db
DATABASE_PORT=5432
DATABASE_NAME=cierre
DATABASE_USER=cierre
DATABASE_PASSWORD=cambiar-esta-clave

# API de consulta (puerto publicado en la máquina)
API_PORT=8081

# Worker de conciliación: número entero de segundos entre conciliaciones (sin unidad)
WORKER_INTERVAL_SECONDS=30
